<Window x:Class="ChudoObuv.Windows.OrderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Чудо Обувь — Заказ" Width="980" Height="720" MinWidth="880" MinHeight="650"
 Icon="/Images/ChudoOvuv.png" FontFamily="Calibri" WindowStartupLocation="CenterOwner">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition x:Name="orderItemsRow" Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Background="#D2F6E7" Padding="8">
   <DockPanel><Image Source="/Images/ChudoOvuv.png" Width="90" Height="50" Stretch="Uniform"/>
    <TextBlock x:Name="userTb" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <StackPanel x:Name="cartPanel" Grid.Row="1" Orientation="Horizontal">
   <TextBlock Text="Клиент:" VerticalAlignment="Center"/>
   <ComboBox x:Name="clientCb" Width="420" Margin="5" DisplayMemberPath="FullName" SelectedValuePath="IdUser"/>
  </StackPanel>
  <DataGrid x:Name="cartGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,5">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Модель" Binding="{Binding ProdName}" Width="*"/>
    <DataGridTextColumn Header="Производство" Binding="{Binding ManufName}" Width="150"/>
    <DataGridTextColumn Header="Размер" Binding="{Binding SizeName}" Width="75"/>
    <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="55"/>
    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice, StringFormat=F2}" Width="100"/>
    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, StringFormat=F2}" Width="110"/>
   </DataGrid.Columns>
  </DataGrid>
  <DataGrid x:Name="ordersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ordersGrid_SelectionChanged" Visibility="Collapsed" Margin="0,5">
   <DataGrid.Columns>
    <DataGridTextColumn Header="№" Binding="{Binding IdOrder}" Width="70"/>
    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="140"/>
    <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientName}" Width="*"/>
    <DataGridTextColumn Header="Итого" Binding="{Binding TotalText}" Width="250"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel x:Name="cartActions" Grid.Row="3" Orientation="Horizontal">
   <Button Content="−1 пара" Click="minusBtn_Click"/><Button Content="+1 пара" Click="plusBtn_Click"/>
   <Button Content="Удалить позицию" Click="removeCartBtn_Click"/>
   <Button Content="Отказаться от заказа" Click="clearBtn_Click"/>
  </StackPanel>
  <StackPanel x:Name="manageActions" Grid.Row="3" Orientation="Horizontal" Visibility="Collapsed">
   <Button Content="Новый заказ из каталога" Click="newBtn_Click" Background="#70B2AF"/>
   <Button Content="Удалить заказ" Click="deleteBtn_Click"/>
   <DatePicker x:Name="orderDatePicker" DateValidationError="orderDatePicker_DateValidationError" Width="140" Margin="5"/>
   <Button x:Name="saveDateBtn" Content="Сохранить дату" Click="saveDateBtn_Click"/>
   <Button x:Name="removeItemBtn" Content="Удалить позицию" Click="removeItemBtn_Click"/>
  </StackPanel>
  <DataGrid x:Name="itemsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Visibility="Collapsed" Margin="0,5">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Модель / производство" Binding="{Binding ModelName}" Width="*"/>
    <DataGridTextColumn Header="Размер" Binding="{Binding SizeName}" Width="160"/>
    <DataGridTextColumn Header="Пар" Binding="{Binding Quantity, TargetNullValue=Неизвестно}" Width="95"/>
    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice, StringFormat=F2, TargetNullValue=Неизвестно}" Width="110"/>
    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, StringFormat=F2, TargetNullValue=Неизвестно}" Width="110"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="5">
   <TextBlock x:Name="totalTb" FontSize="18" HorizontalAlignment="Right"/>
   <TextBlock x:Name="hintTb" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="confirmBtn" Content="Подтвердить заказ" Click="confirmBtn_Click" Background="#70B2AF"/>
    <Button Content="Назад" Click="CloseWindow"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
